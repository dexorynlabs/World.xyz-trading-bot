# =====================================================================
#  world.xyz trading bot — configuration
#  Copy to .env and edit. Every trading parameter lives here.
# =====================================================================

# ---------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------
# buy      -> one-shot market buy of ORDER_SIZE_USD of OUTCOME, then exit
# sell     -> one-shot market sell of SELL_SHARES of OUTCOME, then exit
# strategy -> run the threshold strategy loop (entry / take-profit / stop-loss)
# markets  -> list markets from the catalog (filter with MARKET_SEARCH), then exit
BOT_MODE=markets

# true = quote + sign + risk-check everything, but never broadcast.
DRY_RUN=true

# ---------------------------------------------------------------------
# Wallet (Solana)
# ---------------------------------------------------------------------
# Accepts: base58 secret key (Phantom/Solflare export), a JSON byte array
# "[12,34,...]", or a path to a solana-keygen JSON keypair file.
WALLET_PRIVATE_KEY=

# ---------------------------------------------------------------------
# Network — use a paid, low-latency RPC close to your VPS in production
# ---------------------------------------------------------------------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Extra endpoints the signed tx is fanned out to in parallel (comma separated).
# e.g. Helius / Triton / staked-connection sender URLs.
SOLANA_SEND_RPC_URLS=
# processed | confirmed | finalized
COMMITMENT=confirmed
HTTP_TIMEOUT_MS=5000

# ---------------------------------------------------------------------
# Venue endpoints
# ---------------------------------------------------------------------
# Order builder (DFlow /order compatible). Options:
#   https://aggregator-api-proxy.world-xyz.workers.dev   (World web-app proxy, keyless)
#   https://quote-api.dflow.net                          (DFlow prod, needs DFLOW_API_KEY)
#   https://dev-quote-api.dflow.net                      (DFlow dev, rate-limited, testing)
ORDER_API_URL=https://aggregator-api-proxy.world-xyz.workers.dev
DFLOW_API_KEY=
MARKETS_API_URL=https://markets-api-proxy.world-xyz.workers.dev
# Origin header sent to the World proxies (leave empty to omit).
HTTP_ORIGIN=https://world.xyz

# Collateral: CASH (Bridge/Stripe stablecoin, Token-2022)
COLLATERAL_MINT=CASHx9KJUStyftLFWGvEVf59SGeG9sh5FfcnZMVPCASH
COLLATERAL_DECIMALS=6
OUTCOME_DECIMALS=6

# ---------------------------------------------------------------------
# Market selection
# ---------------------------------------------------------------------
# Either set MARKET_ID (ticker from `BOT_MODE=markets`) and let the bot
# resolve mints from the catalog, or set YES_MINT / NO_MINT directly
# (fastest startup, no catalog dependency).
MARKET_ID=
YES_MINT=
NO_MINT=
# yes | no
OUTCOME=yes
# Case-insensitive filter for BOT_MODE=markets
MARKET_SEARCH=
MARKETS_LIST_LIMIT=50

# ---------------------------------------------------------------------
# Order parameters
# ---------------------------------------------------------------------
# Buy notional in collateral (CASH ~= USD)
ORDER_SIZE_USD=5
# Shares to sell: "all" or a number (e.g. 12.5)
SELL_SHARES=all
# Route slippage tolerance (basis points)
SLIPPAGE_BPS=200
# Prediction-market leg slippage (bps). Empty = venue default.
PREDICTION_MARKET_SLIPPAGE_BPS=
# Priority fee: auto | none | <lamports>
PRIORITY_FEE_LAMPORTS=auto
# Hard price guards (collateral per share, 0..1). Checked on the actual quote.
MAX_BUY_PRICE=0.95
MIN_SELL_PRICE=0.01
# Extra raw query params forwarded to /order, for venue changes without a rebuild.
# Format: key=value&key2=value2
EXTRA_ORDER_PARAMS=

# ---------------------------------------------------------------------
# Strategy (BOT_MODE=strategy) — threshold entry / exit
# ---------------------------------------------------------------------
# Buy when executable ask <= ENTRY_PRICE
ENTRY_PRICE=0.40
# Sell full position when executable bid >= TAKE_PROFIT_PRICE
TAKE_PROFIT_PRICE=0.60
# Sell full position when executable bid <= STOP_LOSS_PRICE
STOP_LOSS_PRICE=0.25
POLL_INTERVAL_MS=500
COOLDOWN_MS=3000
POSITION_REFRESH_MS=10000

# ---------------------------------------------------------------------
# Risk
# ---------------------------------------------------------------------
MAX_ORDER_USD=50
MAX_POSITION_USD=200
MAX_TRADES_PER_DAY=100
# Halt after N consecutive failed executions
MAX_CONSECUTIVE_FAILURES=5

# ---------------------------------------------------------------------
# Execution
# ---------------------------------------------------------------------
CONFIRM_TIMEOUT_MS=30000
CONFIRM_POLL_MS=250
REBROADCAST_INTERVAL_MS=500
SKIP_PREFLIGHT=true

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------
RUST_LOG=info,world_xyz_bot=debug
LOG_JSON=false
